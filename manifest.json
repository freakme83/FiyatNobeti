{
  "manifest_version": 3,
  "name": "FiyatNöbeti",
  "version": "0.1.0",
  "description": "Amazon Türkiye ürünleri için yerel fiyat izleme listesi.",
  "permissions": ["storage", "offscreen", "alarms", "notifications"],
  "optional_host_permissions": [
    "https://www.amazon.com.tr/*",
    "https://amzn.eu/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "FiyatNöbeti",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'none'; frame-src 'none'; connect-src https://www.amazon.com.tr https://amzn.eu"
  }
}
